{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/tournament-tool/?", "dest": "/tournament-tool/index.html" },
    { "src": "/americano-tool/?", "dest": "/americano-tool/index.html" },
    { "src": "/league-tool/?", "dest": "/league-tool/index.html" },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
